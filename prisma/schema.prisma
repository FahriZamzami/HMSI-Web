datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================
enum UserRole {
  SUPERADMIN
  ADMIN
}

enum DivisionRole {
  INTI
  NON_INTI
}

enum MemberRole {
  KADIV
  STAFF
  SEKBEN
  SEKRETARIS
  BENDAHARA
  KAHIM
}

enum ImageType {
  MAIN
  PERSON
}

// ==========================================
// MODELS / TABLES
// ==========================================

model User {
  userId    Int      @id @default(autoincrement()) @map("user_id")
  username  String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi Child
  divisi Divisi[]

  @@map("user")
}

model Periode {
  periodeId Int      @id @default(autoincrement()) @map("periode_id")
  periode   String   // Contoh: "2025/2026"
  status    Boolean  @default(false) // 0 = non aktif, 1 = aktif
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi Child
  divisi Divisi[]

  @@map("periode")
}

model Divisi {
  divisiId     Int          @id @default(autoincrement()) @map("divisi_id")
  userId       Int          @map("user_id")
  periodeId    Int          @map("periode_id")
  namaDivisi   String       @map("nama_divisi")
  divisionRole DivisionRole @map("division_role")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relasi Parent
  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  periode Periode @relation(fields: [periodeId], references: [periodeId], onDelete: Cascade)

  // Relasi Child
  anggotaDivisi AnggotaDivisi[]
  divisiGambar  DivisiGambar[]
  post          Post[]
  proker        Proker[] // Menghubungkan Divisi ke Program Kerja

  @@map("divisi")
}

model AnggotaDivisi {
  anggotaId Int        @id @default(autoincrement()) @map("anggota_id")
  divisiId  Int        @map("divisi_id")
  name      String
  role      MemberRole
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  // Relasi Parent
  divisi Divisi @relation(fields: [divisiId], references: [divisiId], onDelete: Cascade)

  // Relasi Child
  prokerAnggota ProkerAnggota[]

  @@map("anggota_divisi")
}

model Proker {
  prokerId   Int      @id @default(autoincrement()) @map("proker_id")
  divisiId   Int      @map("divisi_id") // Foreign key agar tahu proker ini milik divisi mana
  judul      String
  keterangan String   @db.Text      
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relasi Parent
  divisi Divisi @relation(fields: [divisiId], references: [divisiId], onDelete: Cascade)

  // Relasi Child
  prokerAnggota ProkerAnggota[]

  @@map("proker")
}

// --- JUNCTION TABLE BARU ---
model ProkerAnggota {
  anggotaId Int      @map("anggota_id")
  prokerId  Int      @map("proker_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi Parent
  anggota AnggotaDivisi @relation(fields: [anggotaId], references: [anggotaId], onDelete: Cascade)
  proker  Proker        @relation(fields: [prokerId], references: [prokerId], onDelete: Cascade)

  @@id([anggotaId, prokerId])
  @@map("proker_anggota")
}

model Gambar {
  gambarId  Int      @id @default(autoincrement()) @map("gambar_id")
  fileName  String   @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi Child
  divisiGambar DivisiGambar[]
  postGambar   PostGambar[]

  @@map("gambar")
}

model DivisiGambar {
  divisiId  Int       @map("divisi_id")
  gambarId  Int       @map("gambar_id")
  type      ImageType
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relasi Parent
  divisi Divisi @relation(fields: [divisiId], references: [divisiId], onDelete: Cascade)
  gambar Gambar @relation(fields: [gambarId], references: [gambarId], onDelete: Cascade)

  @@id([divisiId, gambarId])
  @@map("divisi_gambar")
}

model Post {
  postId    Int      @id @default(autoincrement()) @map("post_id")
  divisiId  Int      @map("divisi_id")
  caption   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi Parent
  divisi Divisi @relation(fields: [divisiId], references: [divisiId], onDelete: Cascade)

  // Relasi Child
  postGambar PostGambar[]

  @@map("post")
}

model PostGambar {
  postId    Int      @map("post_id")
  gambarId  Int      @map("gambar_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relasi Parent
  post   Post   @relation(fields: [postId], references: [postId], onDelete: Cascade)
  gambar Gambar @relation(fields: [gambarId], references: [gambarId], onDelete: Cascade)

  @@id([postId, gambarId])
  @@map("post_gambar")
}