datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  userId   Int        @id @default(autoincrement()) @map("user_id")
  name     String
  password String
  status   StatusUser @default(Active)
  created  DateTime   @default(now())
  edited   DateTime   @updatedAt

  @@map("user")
}

enum StatusUser {
  Active
  Maintenance
}

model Periode {
  periodeId     Int           @id @default(autoincrement()) @map("periode_id")
  periode       String
  status        StatusPeriode @default(Active)
  gambarPeriode String?       @map("gambar_periode")
  created       DateTime      @default(now())
  edited        DateTime      @updatedAt

  divisi Divisi[]

  @@map("periode")
}

model Divisi {
  divisiId      Int        @id @default(autoincrement()) @map("divisi_id")
  periodeId     Int        @map("periode_id")
  divisiName    String     @map("divisi_name")
  gambarDivisi  String?    @map("gambar_divisi")
  tentangDivisi String?    @map("tentang_divisi") @db.Text
  created       DateTime   @default(now())
  edited        DateTime   @updatedAt

  periode  Periode    @relation(fields: [periodeId], references: [periodeId], onDelete: Cascade)
  pengurus Pengurus[]
  proker   Proker[]

  @@map("divisi")
}

enum RolePengurus {
  Ketua_Himpunan              @map("Ketua Himpunan")
  Wakil_Ketua_Himpunan        @map("Wakil Ketua Himpunan")
  Sekretaris_Umum             @map("Sekretaris Umum")
  Bendahara_Umum              @map("Bendahara Umum")
  Kepala_Divisi               @map("Kepala Divisi")
  Sekretaris_Divisi           @map("Sekretaris Divisi")
  Bendahara_Divisi            @map("Bendahara Divisi")
  Sekretaris_Bendahara_Divisi @map("Sekretaris Bendahara Divisi")
  Staf_Divisi                 @map("Staf Divisi")
}

enum StatusPeriode {
  Active
  Non_Active @map("Non Active")
}

model Pengurus {
  pengurusId     Int          @id @default(autoincrement()) @map("pengurus_id")
  divisiId       Int          @map("divisi_id")
  role           RolePengurus
  pengurusName   String       @map("pengurus_name")
  nim            String
  nomorAnggota   String       @map("nomor_anggota")
  gambarPengurus String       @map("gambar_pengurus")
  created        DateTime     @default(now())
  edited         DateTime     @updatedAt

  divisi         Divisi           @relation(fields: [divisiId], references: [divisiId], onDelete: Cascade)
  pengurusProker PengurusProker[]

  @@map("pengurus")
}

model Proker {
  prokerId   Int      @id @default(autoincrement()) @map("proker_id")
  divisiId   Int      @map("divisi_id")
  prokerName String   @map("proker_name")
  deskripsi  String   @db.Text
  created    DateTime @default(now())
  edited     DateTime @updatedAt

  divisi         Divisi           @relation(fields: [divisiId], references: [divisiId], onDelete: Cascade)
  pengurusProker PengurusProker[]

  @@map("proker")
}

model PengurusProker {
  pengurusId Int      @map("pengurus_id")
  prokerId   Int      @map("proker_id")
  created    DateTime @default(now())
  edited     DateTime @updatedAt

  pengurus Pengurus @relation(fields: [pengurusId], references: [pengurusId], onDelete: Cascade)
  proker   Proker   @relation(fields: [prokerId], references: [prokerId], onDelete: Cascade)

  @@id([pengurusId, prokerId])
  @@map("pengurus_proker")
}

model Post {
  postId      Int      @id @default(autoincrement()) @map("post_id")
  title       String
  description String   @db.Text
  gambar      String
  created     DateTime @default(now())
  edited      DateTime @updatedAt

  @@map("post")
}

model Saran {
  saranId Int      @id @default(autoincrement()) @map("saran_id")
  saran   String   @db.Text
  gambar  String?
  created DateTime @default(now())
  edited  DateTime @updatedAt

  @@map("saran")
}
